{
  "name": "@megamono/workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "release:check": "node tools/check-release-policy.mjs && node tools/sync-release-pins.mjs --check",
    "release:test": "node --test tools/release-policy.test.mjs tools/release-channel.test.mjs tools/sync-release-pins.test.mjs tools/publishing-setup.test.mjs tools/published-release.test.mjs",
    "release:check-publishing": "node tools/check-publishing-setup.mjs",
    "release:qualify": "node tools/qualify-release.mjs",
    "release:verify-published": "node tools/check-published-release.mjs",
    "build:identity": "node tools/write-build-info.mjs",
    "packages:check-exports": "node tools/write-build-info.mjs && node tools/check-packed-exports.mjs",
    "yalc:publish": "node tools/publish-yalc.mjs",
    "yalc:install-cli": "node tools/install-yalc-cli.mjs",
    "yalc:install-clis": "node tools/install-yalc-cli.mjs",
    "postinstall": "node tools/patch-magicast-bundle.mjs",
    "tooling:check": "nx run @megamono/workspace:tooling-check",
    "tooling:test": "nx run @megamono/workspace:tooling-test"
  },
  "private": true,
  "devDependencies": {
    "@chakra-ui/react": "3.37.0",
    "@content-collections/core": "0.15.3",
    "@emotion/react": "11.14.0",
    "@eslint/js": "^10.0.1",
    "@nx/eslint": "23.3.1",
    "@nx/eslint-plugin": "23.3.1",
    "@nx/expo": "23.3.1",
    "@nx/jest": "23.3.1",
    "@nx/js": "23.3.1",
    "@nx/nest": "23.3.1",
    "@nx/next": "23.3.1",
    "@nx/playwright": "23.3.1",
    "@nx/plugin": "23.3.1",
    "@nx/vite": "23.3.1",
    "@nx/vitest": "23.3.1",
    "@nx/webpack": "23.3.1",
    "@swc-node/register": "~1.12.1",
    "@swc/cli": "~0.8.1",
    "@swc/core": "~1.16.20",
    "@swc/helpers": "~0.5.23",
    "@swc/jest": "0.2.39",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/semver": "7.8.0",
    "@vitest/coverage-v8": "~4.1.12",
    "@vitest/ui": "~4.1.12",
    "eslint": "~10.13.0",
    "gray-matter": "^4.0.3",
    "jest": "30.5.2",
    "jest-environment-node": "30.5.2",
    "jest-util": "30.5.1",
    "jiti": "2.7.0",
    "jsdom": "^27.4.0",
    "jsonc-eslint-parser": "^3.3.0",
    "magicast": "0.5.5",
    "nx": "23.3.1",
    "oxfmt": "0.75.0",
    "prettier": "^3.9.10",
    "source-map-js": "1.2.2",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "verdaccio": "6.11.1",
    "vite": "^8.3.5",
    "vitest": "~4.1.12",
    "zod": "^4.6.7"
  },
  "workspaces": [
    "packages/*"
  ],
  "nx": {
    "includedScripts": [],
    "targets": {
      "local-registry": {
        "executor": "@nx/js:verdaccio",
        "options": {
          "port": 4873,
          "config": ".verdaccio/config.yml",
          "storage": "tmp/local-registry/storage"
        }
      },
      "tooling-check": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node tools/patch-magicast-bundle.mjs --check",
          "cwd": "."
        }
      },
      "tooling-test": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node --test tools/magicast-bundle.test.mjs tools/glob-tooling.test.mjs",
          "cwd": "."
        }
      }
    },
    "tags": [
      "platform:node",
      "scope:shared",
      "type:app",
      "visibility:internal"
    ]
  },
  "dependencies": {
    "@nx/devkit": "23.3.1"
  },
  "overrides": {
    "nx": {
      "brace-expansion": "5.0.12",
      "smol-toml": "^1.9.1",
      "undici": "7.30.1"
    },
    "@jest/reporters@30.5.2": {
      "glob": "14.0.3"
    },
    "jest-config@30.5.2": {
      "glob": "14.0.3"
    },
    "jest-runtime@30.5.2": {
      "glob": "14.0.3"
    },
    "test-exclude@7.0.2": {
      "glob": "14.0.3"
    }
  },
  "packageManager": "npm@11.21.1",
  "allowScripts": {
    "nx@23.3.1": true,
    "@swc/core@1.16.20": true,
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true,
    "esbuild@0.25.12": true
  }
}
