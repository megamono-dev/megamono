{
  "name": "@megamono/workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "release:check-private": "node tools/check-private-publish.mjs",
    "yalc:publish": "node tools/publish-yalc.mjs",
    "yalc:install-cli": "node tools/install-yalc-cli.mjs"
  },
  "private": true,
  "devDependencies": {
    "@content-collections/core": "0.15.2",
    "@eslint/js": "^10.0.1",
    "@nx/eslint": "23.1.1",
    "@nx/eslint-plugin": "23.1.1",
    "@nx/js": "23.1.1",
    "@nx/plugin": "^23.1.1",
    "@nx/vite": "23.1.1",
    "@nx/vitest": "23.1.1",
    "@swc-node/register": "~1.11.1",
    "@swc/cli": "~0.8.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "~4.1.10",
    "@vitest/ui": "~4.1.10",
    "eslint": "~10.6.0",
    "gray-matter": "^4.0.3",
    "jiti": "2.4.2",
    "jsdom": "^27.1.0",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "23.1.1",
    "prettier": "^3.8.1",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.63.0",
    "verdaccio": "6.10.0",
    "vite": "^8.1.4",
    "vitest": "~4.1.10",
    "zod": "^4.1.12"
  },
  "workspaces": [
    "packages/*"
  ],
  "nx": {
    "includedScripts": [],
    "targets": {
      "local-registry": {
        "executor": "@nx/js:verdaccio",
        "options": {
          "port": 4873,
          "config": ".verdaccio/config.yml",
          "storage": "tmp/local-registry/storage"
        }
      }
    },
    "tags": [
      "platform:node",
      "scope:shared",
      "type:app",
      "visibility:internal"
    ]
  },
  "dependencies": {
    "@nx/devkit": "23.1.1"
  },
  "overrides": {
    "nx": {
      "brace-expansion": "5.0.9"
    }
  }
}
