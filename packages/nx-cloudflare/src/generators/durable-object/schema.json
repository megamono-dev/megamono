{
  "$schema": "https://json-schema.org/schema",
  "$id": "MegamonoCloudflareDurableObject",
  "title": "Add a Durable Object to an existing Cloudflare Worker",
  "type": "object",
  "properties": {
    "project": {
      "type": "string",
      "description": "Existing Nx Worker project name."
    },
    "className": {
      "type": "string",
      "$default": { "$source": "argv", "index": 0 },
      "description": "Durable Object class name."
    },
    "binding": {
      "type": "string",
      "description": "Worker-visible binding name; defaults from the class name."
    },
    "migrationTag": {
      "type": "string",
      "default": "v1",
      "description": "Unique Wrangler migration tag."
    },
    "configPath": {
      "type": "string",
      "description": "Explicit Wrangler config when the project contains more than one."
    },
    "dryRun": {
      "type": "boolean",
      "default": false,
      "description": "Print the deterministic plan without mutation."
    }
  },
  "required": ["project", "className"],
  "additionalProperties": false
}
