{
  "name": "@megamono/nx-cloudflare",
  "version": "0.0.1",
  "license": "MIT",
  "description": "Nx plugin inferring Cloudflare Worker projects, binding graph edges, and targets from Wrangler configuration.",
  "keywords": [
    "megamono",
    "nx",
    "nx-plugin",
    "cloudflare",
    "workers",
    "wrangler",
    "durable-objects"
  ],
  "author": "Ryan Hefner",
  "homepage": "https://github.com/megamono-dev/megamono/tree/main/packages/nx-cloudflare#readme",
  "bugs": {
    "url": "https://github.com/megamono-dev/megamono/issues"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./build-info.json": "./dist/build-info.json",
    ".": {
      "@megamono/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!**/*.tsbuildinfo",
    "generators.json"
  ],
  "generators": "./generators.json",
  "nx": {
    "name": "nx-cloudflare",
    "targets": {
      "build": {
        "executor": "@nx/js:tsc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/nx-cloudflare/dist",
          "main": "packages/nx-cloudflare/src/index.ts",
          "tsConfig": "packages/nx-cloudflare/tsconfig.lib.json",
          "rootDir": "packages/nx-cloudflare/src",
          "generatePackageJson": false,
          "assets": [
            {
              "input": "./packages/nx-cloudflare/src",
              "glob": "**/!(*.ts)",
              "output": "."
            },
            {
              "input": "./packages/nx-cloudflare/src",
              "glob": "**/*.d.ts",
              "output": "."
            }
          ]
        }
      },
      "e2e-local-registry": {
        "executor": "nx:run-commands",
        "cache": false,
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "node packages/nx-cloudflare/e2e/local-registry.e2e.mjs",
          "cwd": "."
        }
      }
    },
    "tags": [
      "platform:node",
      "scope:shared",
      "type:util"
    ]
  },
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "semver": "7.8.5",
    "smol-toml": "^1.8.0",
    "tslib": "^2.3.0"
  },
  "peerDependencies": {
    "@nx/devkit": ">=18 <24",
    "nx": ">=18 <24",
    "wrangler": ">=4.105 <5"
  },
  "peerDependenciesMeta": {
    "wrangler": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.18 <25",
    "pnpm": ">=8 <12",
    "npm": ">=9 <12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/megamono-dev/megamono.git",
    "directory": "packages/nx-cloudflare"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
