{
  "$schema": "https://json-schema.org/schema",
  "$id": "MegamonoExtensionApplication",
  "title": "Create a WXT browser extension",
  "type": "object",
  "required": ["name"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "$default": { "$source": "argv", "index": 0 }
    },
    "projectName": { "type": "string", "minLength": 1 },
    "directory": { "type": "string" },
    "scope": { "type": "string" },
    "tags": { "type": "string" },
    "displayName": { "type": "string" },
    "manifestVersion": {
      "type": "number",
      "enum": [2, 3],
      "description": "Explicit manifest version for Chrome and Firefox. Omit to retain WXT configuration/defaults."
    },
    "skipFormat": { "type": "boolean", "default": false }
  },
  "additionalProperties": false
}
