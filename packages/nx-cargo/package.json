{
  "name": "@megamono/nx-cargo",
  "version": "0.1.0-next.0",
  "license": "MIT",
  "description": "Nx plugin inferring Cargo and Rust projects, targets, and graph edges from Cargo manifests.",
  "keywords": [
    "megamono",
    "nx",
    "nx-plugin",
    "cargo",
    "rust",
    "tauri"
  ],
  "author": "Ryan Hefner",
  "homepage": "https://github.com/megamono-dev/megamono/tree/main/packages/nx-cargo#readme",
  "bugs": {
    "url": "https://github.com/megamono-dev/megamono/issues"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./build-info.json": "./dist/build-info.json",
    ".": {
      "@megamono/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!**/*.tsbuildinfo",
    "executors.json"
  ],
  "nx": {
    "name": "nx-cargo",
    "targets": {
      "e2e-native-execution": {
        "executor": "nx:run-commands",
        "cache": false,
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "node packages/nx-cargo/e2e/native-execution.e2e.mjs"
        }
      },
      "build": {
        "executor": "@nx/js:tsc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/nx-cargo/dist",
          "main": "packages/nx-cargo/src/index.ts",
          "tsConfig": "packages/nx-cargo/tsconfig.lib.json",
          "rootDir": "packages/nx-cargo/src",
          "generatePackageJson": false,
          "assets": [
            {
              "input": "./packages/nx-cargo/src",
              "glob": "**/!(*.ts)",
              "output": "."
            },
            {
              "input": "./packages/nx-cargo/src",
              "glob": "**/*.d.ts",
              "output": "."
            }
          ]
        }
      },
      "e2e-local-registry": {
        "executor": "nx:run-commands",
        "cache": false,
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "node packages/nx-cargo/e2e/local-registry.e2e.mjs",
          "cwd": "."
        }
      }
    },
    "tags": [
      "platform:node",
      "scope:shared",
      "type:util"
    ]
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "peerDependencies": {
    "@nx/devkit": ">=18 <24",
    "nx": ">=18 <24"
  },
  "engines": {
    "node": ">=18.18 <25",
    "pnpm": ">=8 <12",
    "npm": ">=9 <12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/megamono-dev/megamono.git",
    "directory": "packages/nx-cargo"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "executors": "./executors.json"
}
