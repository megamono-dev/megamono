{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://megamono.com/schemas/megamono.schema.json",
  "title": "Megamono workspace configuration",
  "$defs": {
    "ruleOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity"],
      "properties": {
        "severity": { "enum": ["off", "warning", "error"] },
        "decision": {
          "type": "string",
          "pattern": "^decision-[0-9]{8}-[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      }
    },
    "structuralRuleOverride": {
      "allOf": [
        { "$ref": "#/$defs/ruleOverride" },
        {
          "if": {
            "properties": { "severity": { "const": "off" } },
            "required": ["severity"]
          },
          "then": { "required": ["decision"] }
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "not": {
        "required": ["databases", "prisma"]
      }
    }
  ],
  "required": ["version", "conventions"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "conventions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nestFeatureLibraries",
        "docsLocation",
        "packageManager",
        "rules"
      ],
      "properties": {
        "nestFeatureLibraries": { "type": "boolean" },
        "docsLocation": { "const": "centralized" },
        "packageManager": {
          "type": "string",
          "enum": ["pnpm", "npm"],
          "default": "pnpm"
        },
        "apps": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "web": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "router": { "const": "pages" },
                "src": { "const": true },
                "ui": { "const": "chakra" },
                "e2e": { "const": "playwright" }
              }
            },
            "api": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "framework": { "const": "nest" },
                "featureLibraries": { "const": true },
                "e2e": { "const": "jest" }
              }
            }
          }
        },
        "rules": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "module-boundaries": { "$ref": "#/$defs/structuralRuleOverride" },
            "docs-visibility-boundary": { "$ref": "#/$defs/ruleOverride" },
            "no-deep-relative-imports": { "$ref": "#/$defs/ruleOverride" },
            "require-tags": { "$ref": "#/$defs/structuralRuleOverride" },
            "naming-convention": { "$ref": "#/$defs/structuralRuleOverride" },
            "megamono-dev-only": { "$ref": "#/$defs/structuralRuleOverride" },
            "playstack-direction": { "$ref": "#/$defs/structuralRuleOverride" },
            "platform-boundary": { "$ref": "#/$defs/structuralRuleOverride" },
            "no-bare-jsx-strings": { "$ref": "#/$defs/ruleOverride" }
          }
        }
      }
    },
    "adoption": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modules": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "docs",
              "agents",
              "ci",
              "release",
              "lint",
              "skills",
              "health",
              "inference"
            ]
          }
        },
        "reductions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["module", "capability", "reason"],
            "properties": {
              "module": {
                "enum": [
                  "docs",
                  "agents",
                  "ci",
                  "release",
                  "lint",
                  "skills",
                  "health",
                  "inference"
                ]
              },
              "capability": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "inference": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "apple": {
              "type": "object",
              "additionalProperties": false,
              "required": ["plugin", "manifests"],
              "properties": {
                "plugin": { "const": "@megamono/nx-apple" },
                "manifests": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
                  }
                }
              }
            },
            "cargo": {
              "type": "object",
              "additionalProperties": false,
              "required": ["plugin", "manifests"],
              "properties": {
                "plugin": { "const": "@megamono/nx-cargo" },
                "manifests": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
                  }
                }
              }
            },
            "cloudflare": {
              "type": "object",
              "additionalProperties": false,
              "required": ["plugin", "manifests"],
              "properties": {
                "plugin": { "const": "@megamono/nx-cloudflare" },
                "manifests": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
                  }
                }
              }
            }
          }
        },
        "ratchets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rule", "initialCount", "targetSeverity"],
            "properties": {
              "rule": {
                "enum": [
                  "module-boundaries",
                  "docs-visibility-boundary",
                  "no-deep-relative-imports",
                  "require-tags",
                  "naming-convention",
                  "megamono-dev-only",
                  "playstack-direction",
                  "platform-boundary",
                  "no-bare-jsx-strings"
                ]
              },
              "initialCount": { "type": "integer", "minimum": 0 },
              "targetSeverity": { "const": "error" }
            }
          }
        }
      }
    },
    "platforms": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["web", "node", "worker", "apple", "rust", "php", "extension"]
      }
    },
    "ports": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "additionalProperties": {
        "type": "integer",
        "minimum": 1024,
        "maximum": 65535
      }
    },
    "topics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "extend": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    },
    "docs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        },
        "reportRetentionDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cadence": { "enum": ["disabled", "weekly", "daily"] },
        "stalePlanDays": { "type": "integer", "minimum": 7, "maximum": 365 },
        "checks": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "dependency-alignment",
              "spec-drift",
              "stale-plans",
              "orphaned-libraries",
              "integration-template-drift"
            ]
          },
          "additionalProperties": { "type": "boolean" }
        },
        "suppressions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["check", "fingerprint", "decision"],
            "properties": {
              "check": {
                "enum": [
                  "dependency-alignment",
                  "spec-drift",
                  "stale-plans",
                  "orphaned-libraries",
                  "integration-template-drift"
                ]
              },
              "fingerprint": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^*]+$"
              },
              "decision": {
                "type": "string",
                "pattern": "^decision-[0-9]{8}-[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "expires_at": { "type": "string", "format": "date" }
            }
          }
        }
      }
    },
    "databases": {
      "type": "object",
      "default": {},
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["adapter", "project"],
        "properties": {
          "adapter": { "enum": ["prisma", "drizzle"] },
          "project": { "type": "string", "minLength": 1 }
        }
      }
    },
    "prisma": {
      "deprecated": true,
      "$comment": "Read-only compatibility. Use named databases instead.",
      "type": "object",
      "additionalProperties": false,
      "required": ["composition", "projects"],
      "properties": {
        "composition": { "const": "native-multi-file" },
        "projects": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runner": { "enum": ["none", "springbar"] },
        "requirements": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "postgres": { "type": "string", "minLength": 1 },
            "redis": { "type": "string", "minLength": 1 },
            "clickhouse": { "type": "string", "minLength": 1 },
            "typesense": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
