{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://megamono.com/schemas/megamono.schema.json",
  "title": "Megamono workspace configuration",
  "$defs": {
    "packageSourceProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["localReferences"],
      "properties": {
        "localReferences": {
          "enum": ["allow", "warn", "reject"]
        },
        "approved": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        }
      }
    },
    "ruleOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity"],
      "properties": {
        "severity": {
          "enum": ["off", "warning", "error"]
        },
        "decision": {
          "type": "string",
          "pattern": "^decision-[0-9]{8}-[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      }
    },
    "structuralRuleOverride": {
      "allOf": [
        {
          "$ref": "#/$defs/ruleOverride"
        },
        {
          "if": {
            "properties": {
              "severity": {
                "const": "off"
              }
            },
            "required": ["severity"]
          },
          "then": {
            "required": ["decision"]
          }
        }
      ]
    },
    "dependencyProjectClassification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "tags"],
      "properties": {
        "kind": {
          "enum": ["app", "lib", "e2e"]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:type|scope|platform|role):[a-z0-9]+(?:[-:][a-z0-9]+)*$"
          }
        }
      }
    },
    "dependencyClassification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependencyKind", "source", "target"],
      "properties": {
        "dependencyKind": {
          "enum": ["implicit", "static", "dynamic"]
        },
        "source": {
          "$ref": "#/$defs/dependencyProjectClassification"
        },
        "target": {
          "$ref": "#/$defs/dependencyProjectClassification"
        }
      }
    },
    "dependencyFindingIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "source", "target", "constraint", "classification"],
      "properties": {
        "rule": {
          "const": "module-boundaries"
        },
        "source": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9@][a-zA-Z0-9@._/:-]*$"
        },
        "target": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9@][a-zA-Z0-9@._/:-]*$"
        },
        "constraint": {
          "enum": [
            "module-boundaries:type-direction",
            "module-boundaries:scope-direction"
          ]
        },
        "classification": {
          "$ref": "#/$defs/dependencyClassification"
        }
      }
    },
    "boundaryAllowance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "target",
        "constraint",
        "classification",
        "rationale",
        "decision"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9@][a-zA-Z0-9@._/:-]*$"
        },
        "target": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9@][a-zA-Z0-9@._/:-]*$"
        },
        "constraint": {
          "enum": [
            "module-boundaries:type-direction",
            "module-boundaries:scope-direction"
          ]
        },
        "classification": {
          "$ref": "#/$defs/dependencyClassification"
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "decision": {
          "type": "string",
          "pattern": "^decision-[0-9]{8}-[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      }
    },
    "warningBaselineEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "reason", "reviewReference", "revision"],
      "properties": {
        "identity": {
          "$ref": "#/$defs/dependencyFindingIdentity"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reviewReference": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "revision": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        }
      }
    },
    "warningBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identityVersion", "rules", "entries"],
      "properties": {
        "identityVersion": {
          "const": 1
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "const": "module-boundaries"
          }
        },
        "entries": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/warningBaselineEntry"
          }
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "not": {
        "required": ["databases", "prisma"]
      }
    },
    {
      "if": {
        "properties": {
          "version": {
            "const": 1
          }
        },
        "required": ["version"]
      },
      "then": {
        "properties": {
          "conventions": {
            "not": {
              "required": ["boundaryAllowances"]
            }
          },
          "adoption": {
            "not": {
              "required": ["warningBaseline"]
            }
          }
        }
      }
    }
  ],
  "required": ["version", "conventions"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "enum": [1, 2],
      "description": "Version 1 retains legacy behavior; version 2 explicitly enables reviewed adoption policy."
    },
    "conventions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nestFeatureLibraries",
        "docsLocation",
        "packageManager",
        "rules"
      ],
      "properties": {
        "nestFeatureLibraries": {
          "type": "boolean"
        },
        "docsLocation": {
          "const": "centralized"
        },
        "packageManager": {
          "type": "string",
          "enum": ["pnpm", "npm"],
          "default": "pnpm"
        },
        "apps": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "web": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "router": {
                  "const": "pages"
                },
                "src": {
                  "const": true
                },
                "ui": {
                  "const": "chakra",
                  "deprecated": true,
                  "description": "Legacy compatibility only; use scaffolding.web.styling."
                },
                "e2e": {
                  "const": "playwright"
                }
              }
            },
            "api": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "framework": {
                  "const": "nest"
                },
                "featureLibraries": {
                  "const": true
                },
                "e2e": {
                  "const": "jest"
                }
              }
            }
          }
        },
        "rules": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "module-boundaries": {
              "$ref": "#/$defs/structuralRuleOverride"
            },
            "docs-visibility-boundary": {
              "$ref": "#/$defs/ruleOverride"
            },
            "no-deep-relative-imports": {
              "$ref": "#/$defs/ruleOverride"
            },
            "require-tags": {
              "$ref": "#/$defs/structuralRuleOverride"
            },
            "naming-convention": {
              "$ref": "#/$defs/structuralRuleOverride"
            },
            "megamono-dev-only": {
              "$ref": "#/$defs/structuralRuleOverride"
            },
            "playstack-direction": {
              "$ref": "#/$defs/structuralRuleOverride"
            },
            "platform-boundary": {
              "$ref": "#/$defs/structuralRuleOverride"
            },
            "no-bare-jsx-strings": {
              "$ref": "#/$defs/ruleOverride"
            }
          }
        },
        "boundaryAllowances": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/boundaryAllowance"
          },
          "description": "Version 2 only. Exact reviewed type/scope permissions; graph, decision, duplicate-key and stale-policy validation is performed by the checker."
        }
      }
    },
    "scaffolding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "web": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "styling": {
              "type": "string",
              "enum": [
                "auto",
                "chakra",
                "emotion",
                "tailwind",
                "panda",
                "stylex",
                "css-modules",
                "inline"
              ],
              "default": "auto",
              "description": "Preferred renderer for newly scaffolded web billboards; it is not enforced on existing applications."
            }
          }
        }
      }
    },
    "adoption": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modules": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "docs",
              "agents",
              "ci",
              "release",
              "lint",
              "skills",
              "health",
              "inference"
            ]
          }
        },
        "reductions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["module", "capability", "reason"],
            "properties": {
              "module": {
                "enum": [
                  "docs",
                  "agents",
                  "ci",
                  "release",
                  "lint",
                  "skills",
                  "health",
                  "inference"
                ]
              },
              "capability": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "inference": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "apple": {
              "type": "object",
              "additionalProperties": false,
              "required": ["plugin", "manifests"],
              "properties": {
                "plugin": {
                  "const": "@megamono/nx-apple"
                },
                "manifests": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
                  }
                }
              }
            },
            "cargo": {
              "type": "object",
              "additionalProperties": false,
              "required": ["plugin", "manifests"],
              "properties": {
                "plugin": {
                  "const": "@megamono/nx-cargo"
                },
                "manifests": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
                  }
                }
              }
            },
            "cloudflare": {
              "type": "object",
              "additionalProperties": false,
              "required": ["plugin", "manifests"],
              "properties": {
                "plugin": {
                  "const": "@megamono/nx-cloudflare"
                },
                "manifests": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
                  }
                }
              }
            }
          }
        },
        "ratchets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rule", "initialCount", "targetSeverity"],
            "properties": {
              "rule": {
                "enum": [
                  "module-boundaries",
                  "docs-visibility-boundary",
                  "no-deep-relative-imports",
                  "require-tags",
                  "naming-convention",
                  "megamono-dev-only",
                  "playstack-direction",
                  "platform-boundary",
                  "no-bare-jsx-strings"
                ]
              },
              "initialCount": {
                "type": "integer",
                "minimum": 0
              },
              "targetSeverity": {
                "const": "error"
              }
            }
          }
        },
        "warningBaseline": {
          "$ref": "#/$defs/warningBaseline"
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["warningBaseline"]
          },
          "then": {
            "properties": {
              "ratchets": {
                "not": {
                  "contains": {
                    "type": "object",
                    "required": ["rule"],
                    "properties": {
                      "rule": {
                        "const": "module-boundaries"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "platforms": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "web",
          "node",
          "worker",
          "mobile",
          "apple",
          "android",
          "rust",
          "php",
          "extension"
        ]
      }
    },
    "ports": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 1024,
        "maximum": 65535
      }
    },
    "topics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "extend": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    },
    "docs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        },
        "reportRetentionDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        },
        "loader": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        },
        "module": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._/-]*$"
        },
        "output": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        },
        "loaderMode": {
          "enum": ["create", "adopt"]
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cadence": {
          "enum": ["disabled", "weekly", "daily"]
        },
        "stalePlanDays": {
          "type": "integer",
          "minimum": 7,
          "maximum": 365
        },
        "checks": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "dependency-alignment",
              "spec-drift",
              "stale-plans",
              "orphaned-libraries",
              "integration-template-drift"
            ]
          },
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "projectAliases": {
          "type": "object",
          "default": {},
          "propertyNames": {
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "suppressions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["check", "fingerprint", "decision"],
            "properties": {
              "check": {
                "enum": [
                  "dependency-alignment",
                  "spec-drift",
                  "stale-plans",
                  "orphaned-libraries",
                  "integration-template-drift"
                ]
              },
              "fingerprint": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^*]+$"
              },
              "decision": {
                "type": "string",
                "pattern": "^decision-[0-9]{8}-[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "expires_at": {
                "type": "string",
                "format": "date"
              }
            }
          }
        }
      }
    },
    "databases": {
      "type": "object",
      "default": {},
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["adapter", "project"],
        "properties": {
          "adapter": {
            "enum": ["prisma", "drizzle"]
          },
          "project": {
            "type": "string",
            "minLength": 1
          },
          "schema": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
          }
        }
      }
    },
    "prisma": {
      "deprecated": true,
      "$comment": "Read-only compatibility. Use named databases instead.",
      "type": "object",
      "additionalProperties": false,
      "required": ["composition", "projects"],
      "properties": {
        "composition": {
          "const": "native-multi-file"
        },
        "projects": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runner": {
          "enum": ["none", "springbar"]
        },
        "requirements": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "postgres": {
              "type": "string",
              "minLength": 1
            },
            "redis": {
              "type": "string",
              "minLength": 1
            },
            "clickhouse": {
              "type": "string",
              "minLength": 1
            },
            "typesense": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "packageSources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profiles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "development": {
              "$ref": "#/$defs/packageSourceProfile"
            },
            "migration": {
              "$ref": "#/$defs/packageSourceProfile"
            },
            "ci": {
              "$ref": "#/$defs/packageSourceProfile"
            },
            "release": {
              "$ref": "#/$defs/packageSourceProfile"
            }
          }
        },
        "registries": {
          "type": "object",
          "propertyNames": {
            "pattern": "^@[a-z0-9][a-z0-9._-]*$"
          },
          "additionalProperties": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        },
        "forbidLocalInCi": {
          "type": "boolean",
          "default": true
        }
      }
    }
  }
}
