{
  "generators": {
    "workspace-init": {
      "factory": "./dist/generators/workspace-init/workspace-init",
      "schema": "./dist/generators/workspace-init/schema.json",
      "description": "Initialize Megamono repository configuration and documentation"
    },
    "workspace-eject": {
      "factory": "./dist/generators/workspace-eject/workspace-eject",
      "schema": "./dist/generators/workspace-eject/schema.json",
      "description": "Make a managed Megamono workspace artifact repository-owned"
    },
    "app": {
      "factory": "./dist/generators/app/app",
      "schema": "./dist/generators/app/schema.json",
      "description": "Add a convention-aligned application"
    },
    "database": {
      "factory": "./dist/generators/database/database",
      "schema": "./dist/generators/database/schema.json",
      "description": "Create or adopt a named database project"
    },
    "skill-eject": {
      "factory": "./dist/generators/skill-eject/skill-eject",
      "schema": "./dist/generators/skill-eject/schema.json",
      "description": "Make a managed Megamono skill repository-owned"
    },
    "convert": {
      "factory": "./dist/generators/convert/convert",
      "schema": "./dist/generators/convert/schema.json",
      "description": "Convert an existing npm repository into a planned Megamono workspace"
    },
    "docs-init": {
      "factory": "./dist/generators/docs-init/docs-init",
      "schema": "./dist/generators/docs-init/schema.json",
      "description": "Adopt the Megamono docs, agents, and skills modules"
    },
    "docs-spec": {
      "factory": "./dist/generators/docs-spec/docs-spec",
      "schema": "./dist/generators/docs-spec/schema.json",
      "description": "Create the next numbered specification record for a project"
    },
    "docs-plan": {
      "factory": "./dist/generators/docs-plan/docs-plan",
      "schema": "./dist/generators/docs-plan/schema.json",
      "description": "Create a backlog plan record"
    },
    "docs-decision": {
      "factory": "./dist/generators/docs-decision/docs-decision",
      "schema": "./dist/generators/docs-decision/schema.json",
      "description": "Create a proposed decision record"
    },
    "docs-research": {
      "factory": "./dist/generators/docs-research/docs-research",
      "schema": "./dist/generators/docs-research/schema.json",
      "description": "Create an active research record"
    },
    "docs-audit": {
      "factory": "./dist/generators/docs-audit/docs-audit",
      "schema": "./dist/generators/docs-audit/schema.json",
      "description": "Create an audit skeleton against a named specification"
    },
    "content-lib": {
      "factory": "./dist/generators/content-lib/content-lib",
      "schema": "./dist/generators/content-lib/schema.json",
      "description": "Create a content collection library"
    },
    "content-type": {
      "factory": "./dist/generators/content-type/content-type",
      "schema": "./dist/generators/content-type/schema.json",
      "description": "Add a document type to a content collection library"
    },
    "emails-adopt": {
      "factory": "./dist/generators/emails-adopt/emails-adopt",
      "schema": "./dist/generators/emails-adopt/schema.json",
      "description": "Adopt an existing application-owned email preview and verification target"
    },
    "playstack-lint": {
      "factory": "./dist/generators/playstack-lint/playstack-lint",
      "schema": "./dist/generators/playstack-lint/schema.json",
      "description": "Add Playstack API lint rules in warning mode"
    },
    "playstack-skills": {
      "factory": "./dist/generators/playstack-skills/playstack-skills",
      "schema": "./dist/generators/playstack-skills/schema.json",
      "description": "Install and synchronize Playstack product skills"
    },
    "playstack-integrate": {
      "factory": "./dist/generators/playstack-integrate/playstack-integrate",
      "schema": "./dist/generators/playstack-integrate/schema.json",
      "description": "Materialize package-authored application integration wiring"
    }
  }
}
