{
  "$schema": "https://json-schema.org/schema",
  "$id": "MegamonoLibrary",
  "title": "Add a TypeScript library",
  "type": "object",
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "scope": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "platform": {
      "type": "string",
      "enum": ["neutral", "web", "node", "mobile", "worker"],
      "default": "neutral"
    },
    "type": {
      "type": "string",
      "enum": ["util", "ui", "data", "feature"],
      "default": "util"
    },
    "publishable": {
      "type": "boolean",
      "default": false,
      "description": "Generate a buildable package in packages/ instead of an internal library in libs/. Does not enroll it in release automation."
    },
    "access": {
      "type": "string",
      "enum": ["restricted", "public"],
      "description": "Registry access for a publishable package; defaults to restricted."
    },
    "skipInstall": {
      "type": "boolean",
      "default": false,
      "description": "Write dependency declarations but do not run the deferred dependency installation."
    },
    "dryRun": { "type": "boolean", "default": false },
    "planOnly": { "type": "boolean", "default": false },
    "yes": {
      "type": "boolean",
      "default": false,
      "description": "Apply the reviewed plan; otherwise only display it."
    }
  },
  "required": ["name"],
  "additionalProperties": false
}
