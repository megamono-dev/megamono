{
  "executors": {
    "docs-validate": {
      "implementation": "./dist/executors/docs-validate/docs-validate",
      "schema": "./dist/executors/docs-validate/schema.json",
      "description": "Validate Megamono repository documentation"
    },
    "docs-index": {
      "implementation": "./dist/executors/docs-index/docs-index",
      "schema": "./dist/executors/docs-index/schema.json",
      "description": "Generate deterministic Megamono documentation indexes"
