{
  "name": "@megamono/plugin",
  "version": "0.0.1",
  "license": "MIT",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./availability.json": "./availability.json",
    "./compatibility.json": "./compatibility.json",
    "./emissions.json": "./emissions.json",
    "./schemas/megamono.schema.json": "./schemas/megamono.schema.json",
    "./schemas/artifacts.schema.json": "./schemas/artifacts.schema.json",
    "./eslint": {
      "types": "./dist/eslint/plugin.d.ts",
      "import": "./dist/eslint.cjs",
      "default": "./dist/eslint.cjs"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "availability.json",
    "compatibility.json",
    "emissions.json",
    "schemas",
    "executors.json",
    "generators.json"
  ],
  "nx": {
    "targets": {
      "sync-collections": {
        "executor": "nx:run-commands",
        "cache": false,
        "outputs": [
          "{projectRoot}/generators.json",
          "{projectRoot}/executors.json"
        ],
        "options": {
          "command": "node packages/plugin/scripts/sync-collections.mjs",
          "cwd": "."
        }
      },
      "build": {
        "executor": "@nx/js:tsc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/plugin/dist",
          "main": "packages/plugin/src/index.ts",
          "tsConfig": "packages/plugin/tsconfig.lib.json",
          "rootDir": "packages/plugin/src",
          "generatePackageJson": false,
          "assets": [
            {
              "input": "./packages/plugin/src",
              "glob": "**/!(*.ts)",
              "output": "."
            },
            {
              "input": "./packages/plugin/src",
              "glob": "**/*.d.ts",
              "output": "."
            }
          ]
        }
      },
      "e2e-convert-local-registry": {
        "executor": "nx:run-commands",
        "cache": false,
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "node packages/plugin/e2e/convert-local-registry.e2e.mjs",
          "cwd": "."
        }
      },
      "e2e-collections-local-registry": {
        "executor": "nx:run-commands",
        "cache": false,
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "node packages/plugin/e2e/collections-local-registry.e2e.mjs",
          "cwd": "."
        }
      },
      "e2e-playstack-yalc": {
        "executor": "nx:run-commands",
        "cache": false,
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "node packages/plugin/e2e/playstack-yalc.e2e.mjs",
          "cwd": "."
        }
      },
      "e2e-nx-compatibility": {
        "executor": "nx:run-commands",
        "cache": false,
        "dependsOn": [
          "build",
          {
            "projects": [
              "nx-apple",
              "nx-cargo",
              "nx-cloudflare",
              "nx-extension"
            ],
            "target": "build"
          }
        ],
        "options": {
          "command": "node packages/plugin/e2e/nx-compatibility.e2e.mjs",
          "cwd": "."
        }
      },
      "e2e-portfolio-compatibility": {
        "executor": "nx:run-commands",
        "cache": false,
        "dependsOn": [
          "build",
          {
            "projects": [
              "nx-apple",
              "nx-cargo",
              "nx-cloudflare",
              "nx-extension"
            ],
            "target": "build"
          }
        ],
        "options": {
          "command": "node packages/plugin/e2e/portfolio-compatibility.e2e.mjs",
          "cwd": "."
        }
      }
    },
    "tags": [
      "platform:node",
      "scope:shared",
      "type:util"
    ]
  },
  "dependencies": {
    "@content-collections/core": "0.15.2",
    "enquirer": "2.3.6",
    "gray-matter": "^4.0.3",
    "ignore": "7.0.5",
    "prettier": "^3.8.1",
    "semver": "7.8.5",
    "tslib": "^2.3.0",
    "yaml": "2.9.0",
    "zod": "^4.1.12"
  },
  "peerDependencies": {
    "@nx/devkit": ">=17 <24",
    "@nx/expo": ">=17 <24",
    "@nx/js": ">=17 <24",
    "@nx/nest": ">=17 <24",
    "@nx/next": ">=17 <24",
    "eslint": ">=8 <11",
    "nx": ">=17 <24",
    "typescript": ">=5.2 <7"
  },
  "peerDependenciesMeta": {
    "@nx/expo": {
      "optional": true
    },
    "@nx/js": {
      "optional": true
    },
    "@nx/nest": {
      "optional": true
    },
    "@nx/next": {
      "optional": true
    },
    "eslint": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.18 <25",
    "pnpm": ">=8 <12",
    "npm": ">=9 <12",
    "yarn": ">=1.22 <5",
    "bun": ">=1.1 <2"
  },
  "executors": "./executors.json",
  "generators": "./generators.json",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/megamono-dev/megamono.git",
    "directory": "packages/plugin"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
