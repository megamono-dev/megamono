{
  "name": "@megamono/cli",
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "bin": {
    "megamono": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@megamono/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!**/*.tsbuildinfo",
    "README.md"
  ],
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/js:tsc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/cli/dist",
          "main": "packages/cli/src/index.ts",
          "tsConfig": "packages/cli/tsconfig.lib.json",
          "rootDir": "packages/cli/src",
          "generatePackageJson": false
        }
      },
      "e2e-local-packages": {
        "executor": "nx:run-commands",
        "cache": false,
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "node packages/cli/e2e/local-packages.e2e.mjs",
          "cwd": "."
        }
      },
      "e2e-playstack-yalc": {
        "executor": "nx:run-commands",
        "cache": false,
        "dependsOn": [
          "build",
          "^build"
        ],
        "options": {
          "command": "node packages/cli/e2e/playstack-yalc.e2e.mjs",
          "cwd": "."
        }
      }
    },
    "tags": [
      "platform:node",
      "scope:shared",
      "type:util"
    ]
  },
  "dependencies": {
    "enquirer": "2.3.6",
    "tslib": "^2.3.0"
  },
  "peerDependencies": {
    "@playstack/client-auth": ">=0.1.0-beta.1 <0.2.0"
  },
  "peerDependenciesMeta": {
    "@playstack/client-auth": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.18 <25",
    "pnpm": ">=8 <12",
    "npm": ">=9 <12",
    "yarn": ">=1.22 <5",
    "bun": ">=1.1 <2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/megamono-dev/megamono.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
